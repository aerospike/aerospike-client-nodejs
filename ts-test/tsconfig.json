{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["../typings"]
  },
  "include": ["tests/**/*.ts", "tests/*.ts", "tests/util/*.ts"]
}

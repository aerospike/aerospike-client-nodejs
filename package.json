    "nosql"
  ],
  "homepage": "https://github.com/aerospike/aerospike-client-nodejs",
  "license": "Apache-2.0",
  "main": "lib/aerospike.js",
  "types": "lib/aerospike.d.ts",
  "engines": {
    "node": ">=4"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aerospike/aerospike-client-nodejs.git"

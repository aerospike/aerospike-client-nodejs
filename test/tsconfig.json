{
  "compilerOptions": {
    "target": "es6",
    "module": "node16",
    "moduleResolution": "node16",
    // "outDir": "./test",
    "strict": true,
    // "esModuleInterop": true,
    // This is to prevent tsc from type checking external libraries
    // TODO but we still want to do type checking on our type definition file
    "skipLibCheck": true,
    // "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    // TODO: test this later
    "baseUrl": "./",
    // "paths": {
    //   "aerospike": ["../lib/aerospike"]
    //   // You can add more mappings here
    // }
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "files": ["../lib/aerospike.d.ts"],
}
